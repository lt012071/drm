# ローカル開発環境用設定ファイル
# このファイルをコピーして .env として使用してください

# フロントエンド設定
VITE_API_URL=http://localhost:3001
VITE_SKIP_AUTH=false
VITE_USE_MOCK_SERVICE=false

# バックエンド設定
# Google OAuth2設定（ローカル開発用）
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# セッション設定
SESSION_SECRET=development_session_secret_change_in_production

# データベース設定（Docker PostgreSQL）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drm_db

# Redis設定（Docker Redis）
REDIS_URL=redis://localhost:6379

# アプリケーション設定
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT設定
JWT_SECRET=development_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d