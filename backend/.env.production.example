# AWS本番環境用環境変数

# RDS PostgreSQL
DATABASE_URL=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/drm_production

# セッション設定（ElastiCache Redis）
REDIS_URL=redis://your-elasticache-endpoint.region.cache.amazonaws.com:6379

# Google OAuth2（本番用）
GOOGLE_CLIENT_ID=your_production_client_id
GOOGLE_CLIENT_SECRET=your_production_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# セキュリティ
SESSION_SECRET=your_strong_session_secret_for_production
JWT_SECRET=your_strong_jwt_secret_for_production
JWT_EXPIRES_IN=7d

# アプリケーション設定
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# SSL設定
DB_SSL=true