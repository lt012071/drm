# Google OAuth2設定（ローカル開発用）
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# セッション設定
SESSION_SECRET=your_session_secret_here

# データベース設定
DATABASE_URL=postgresql://username:password@localhost:5432/drm_db

# アプリケーション設定
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT設定
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Asana OAuth2設定
ASANA_CLIENT_ID=your_asana_client_id_here
ASANA_CLIENT_SECRET=your_asana_client_secret_here
ASANA_REDIRECT_URI=http://localhost:3001/auth/asana/callback