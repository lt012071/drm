{
  "name": "drm-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for Daily Report Management System",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "install-browsers": "playwright install",
    "test:unit:frontend": "cd frontend && npm run test",
    "test:unit:backend": "cd backend && npm run test",
    "test:coverage:frontend": "cd frontend && npm run test:coverage",
    "test:coverage:backend": "cd backend && npm run test:coverage",
    "test:all": "npm run test:unit:frontend && npm run test:unit:backend && npm run e2e",
    "start:dev": "docker-compose up -d",
    "stop:dev": "docker-compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.0.2"
  }
}