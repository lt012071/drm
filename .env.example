# データベース設定
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=drm_db
DATABASE_URL=postgresql://postgres:postgres_password@db:5432/drm_db

# Redis設定
REDIS_URL=redis://redis:6379

# JWT設定
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_here

# フロントエンド設定
FRONTEND_URL=http://localhost:3000

# Google OAuth2設定
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Asana OAuth2設定
ASANA_CLIENT_ID=your_asana_client_id_here
ASANA_CLIENT_SECRET=your_asana_client_secret_here
ASANA_REDIRECT_URI=http://localhost:3001/api/asana/auth/callback
ASANA_USE_PERSONAL_TOKEN=false
ASANA_PERSONAL_ACCESS_TOKEN=your_asana_personal_token_here

# 開発・テスト設定
NODE_ENV=development
SKIP_AUTH=true